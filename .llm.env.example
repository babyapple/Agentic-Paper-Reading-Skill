# `cp .llm.env.example .llm.env` 然后把 key 填进去。
# `.llm.env` 已在 .gitignore 里，密钥不会进仓库；本文件只是模板，可以安全提交。
#
# 读取顺序：命令行参数 > .llm.env > 环境变量 > 默认值
#   --config PATH      用别的配置文件
#   LLM_CONFIG_FILE    environment variable 指定配置文件路径
#   --no-config        忽略配置文件（CI / 测试用）

LLM_API_KEY=sk-替换成你自己的
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# 选填
#LLM_TIMEOUT=60
#LLM_MAX_RETRIES=2
#LLM_MAX_TOKENS=1200
